<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chart_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hd_surface"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/chart_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/hd_toolbar"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:theme="@style/Theme.HarleyDroid.AppBarOverlay"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:popupTheme="@style/Theme.HarleyDroid.PopupOverlay"
            app:titleTextColor="@color/hd_on_surface" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:alpha="0.85"
            android:background="?attr/colorPrimary" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:id="@+id/chart_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="@dimen/space_12">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chart_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="@dimen/space_8"
                app:singleLine="true"
                app:singleSelection="false" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/chart_legend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textAppearance="@style/TextAppearance.HarleyDroid.Label"
            android:textColor="@color/hd_on_surface_60" />

        <TextView
            android:id="@+id/chart_readout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.HarleyDroid.Value"
            android:textColor="@color/hd_on_surface" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_12"
            android:layout_weight="1"
            android:background="@drawable/bg_section_card"
            android:padding="@dimen/space_8">

            <org.harleydroid.LogChartView
                android:id="@+id/log_chart"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ProgressBar
                android:id="@+id/chart_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
